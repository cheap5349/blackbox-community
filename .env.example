# ===== 黑盒社区 环境配置示例 =====
# 复制本文件为 .env 并填写实际值：cp .env.example .env
# 注意：.env 包含敏感信息，请勿提交到版本库

# 服务端口
PORT=3000

# JWT 签名密钥：必须设置，生产环境请用强随机值
# 生成方式：openssl rand -hex 32
# 安全提示：缺失或仍为默认值时，生产环境（NODE_ENV=production）会拒绝启动
JWT_SECRET=

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=heibox

# ===== CORS 白名单（逗号分隔，允许跨域访问 API 的前端来源） =====
# 默认仅放行本地开发端口；生产环境务必改为你的域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 环境标识：development（默认） / production
# 设为 production 时会启用更严格的安全校验
# NODE_ENV=production

# ===== 对象存储（可选，S3 协议：MinIO / 阿里云 OSS / 腾讯云 COS / AWS S3） =====
# 不配置以下任意一项时，自动回退本地磁盘（server/uploads），适合纯本地开发与测试
# 自建 MinIO 示例（docker compose up 会自动配置）：
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
# 浏览器可访问的公网地址（MinIO path-style 需带桶名，如 http://localhost:9000/heibox；云厂商一般为虚拟主机域名）
S3_PUBLIC_URL=
# MinIO 本地部署请保持 true（path-style），云厂商虚拟主机模式可设 false
S3_FORCE_PATH_STYLE=true
